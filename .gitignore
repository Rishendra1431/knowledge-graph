# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
env/

# --- Datasets (never commit datasets; see docs/DATASET.md for how to obtain) --
data/raw/*
!data/raw/.gitkeep
data/interim/
data/processed/
*.zip

# --- Generated artifacts -----------------------------------------------------
# Measurement outputs are reproducible from the code and config; keep local copies
# out of version control so a repository never implies results that were not produced
# on the reader's own machine. Archive them manually for a paper submission.
results/*
!results/.gitkeep
logs/*
!logs/.gitkeep
models/*
!models/.gitkeep

# --- Editors / OS ------------------------------------------------------------
.vscode/*
!.vscode/settings.json
.idea/
*.swp
Thumbs.db
desktop.ini
